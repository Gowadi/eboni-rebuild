      async function sharePage() {
        const url = window.location.href;
        const text =
          "Help Eboni and Boone rebuild after the August 11 storm in Olde Towne East.";
        if (navigator.share) {
          try {
            await navigator.share({ title: "Help Eboni Rebuild", text, url });
          } catch (e) {}
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
          alert("The campaign link was copied. Thank you for sharing!");
        } else {
          window.prompt("Copy the campaign link:", url);
